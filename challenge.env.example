# ==============================================================================
# File:     challenge.env.example
# Purpose:  Template for the production environment file. Copy this to
#           /etc/challenge.env on the server, fill in real values, then:
#
#               sudo chown root:root /etc/challenge.env
#               sudo chmod 600 /etc/challenge.env
#
#           The systemd unit loads it with EnvironmentFile=/etc/challenge.env.
#           Adding or changing a variable here requires a
#           `systemctl restart challenge` before the app sees it.
#
#           For local development none of this is required: config.py falls
#           back to a dev SECRET_KEY, and with SMTP_HOST unset the mail module
#           logs messages to the console instead of sending them, so the
#           password-reset flow can be exercised end to end with no real SMTP.
# ==============================================================================

# Signs Flask session cookies. MUST be a long random string in production --
# if it is unset, config.py falls back to a known dev value and session
# cookies become forgeable by anyone who reads this repository.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ------------------------------------------------------------------------------
# Outbound mail — password resets and admin notifications
# ------------------------------------------------------------------------------
# SMTP_USER must be the exact address the SMTP token was issued for, and
# MAIL_FROM must match it. This is not a stylistic preference: a mismatch
# authenticates as nobody and the provider answers 535, which the app logs
# and then swallows -- the member still sees "a reset link is on its way"
# and nothing arrives. That failure mode went unnoticed here for three
# months. If mail silently stops working, check these two lines first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Address that receives an email when someone registers or submits a
# completion. Leave unset to turn notifications off; the app treats a missing
# value as "notifications are disabled" rather than as an error.
NOTIFY_EMAIL=
